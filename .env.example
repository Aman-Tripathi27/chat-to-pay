# Password to sign in to the app (pick a long one: it protects customer names, phones and addresses).
APP_PASSWORD=

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Razorpay API keys from Dashboard → Account & Settings → API Keys.
# Start with test keys (rzp_test_...). Leave both empty to run in demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
